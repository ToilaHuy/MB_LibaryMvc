@model WebApplication8.Models.BorrowingHistoryVm



<div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header">
            <h1 class="modal-title fs-5" id="staticBackdropLabel">Are you sure you want to delete this?</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            @* <h5 class="card-title">@Model.BorrowerName</h5> *@
            @* <p class="card-text">Category: @Model.Address</p> *@
            
        </div>
        <div class="modal-footer">
            <form asp-action="Delete">
                <input type="hidden" asp-for="@Model.BorrowingHistoryId" name="id" />
                <input  type="submit" value="Delete" class="btn btn-danger" />
            </form>
        </div>
    </div>
</div>


