@model IEnumerable<WebApplication8.Data.BorrowingHistory>

@{
    ViewData["Title"] = "Index";
}

<p class="d-flex justify-content-between">
    <a asp-action="Create" class="btn btn-primary">Borrow</a>
    
    @if (Model.Count() > 0)
    {      
    <a asp-action="Delete" class="btn btn-primary"> Delete All Record</a>
    }
</p>
@if(Model.Count() == 0)
{
      <h1>Nothing Show</h1>
  
} else
{   
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BorrowDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Borrower)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BorrowDate)
            </td>
          
            <td>
                @Html.DisplayFor(modelItem => item.Borrower.BorrowerName)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.BorrowingHistoryId">Details</a> 
            </td>
        </tr>
}
    </tbody>
</table>
}
