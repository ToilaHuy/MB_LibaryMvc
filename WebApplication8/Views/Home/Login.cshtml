@model WebApplication8.Models.UserViewModel;
@{
  
}

<div class="container-login">
   
    @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { @class = "form-login" }))
    {
        <h1 class="mb-5">Login</h1>
        <div class="form-outline mb-4">
            @Html.LabelFor(model => model.Username, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control" } })
       
            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger", })

        </div>
        <div class="form-outline mb-4">
            @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", type = "password" } })


            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
            @if (ViewBag.loginError != null)
            {
                <div style="color:red">@ViewBag.loginError</div>
            }
        </div>
        <div class="form-group mt-2">
            <input type="submit" value="Login" class="btn btn-primary" style="min-width:100%"/>
        </div>
    }
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}