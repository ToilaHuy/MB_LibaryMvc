@using Microsoft.AspNetCore.Mvc.Routing

@{
    var urlHelper = new UrlHelper(ViewContext);
    var currentPath = urlHelper.ActionContext.HttpContext.Request.Path;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication8</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/WebApplication8.styles.css" asp-append-version="true" /> *@
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>
<body>
    @if (@currentPath == "/Home/Login")
    {
        <div>
            @RenderBody()
        </div>
    }
    else
    {
        <div class="app-background">
            <header>
                <nav class=" ">
                   
                    <div class="navbar-header d-flex align-items-center @(currentPath == "/" ? "active" : "")  ">
                        <i class="fa-solid fa-house"></i>
                        <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </div>
                    <div class="container-nav  ">
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">

                                <li class="nav-item  @(currentPath == "/Items" ? "active" : "") ">
                                    <i class="fa-solid fa-book-skull"></i>
                                    <a class="nav-link  " asp-area="" asp-controller="Items" asp-action="Index">Item</a>
                                </li>
                                <li class="nav-item @(currentPath == "/Borrowers" ? "active" : "")">
                                    <i class="fa-solid fa-user"></i>
                                    <a class="nav-link " asp-area="" asp-controller="Borrowers" asp-action="Index">Borrower</a>
                                </li>
                                <li class="nav-item @(currentPath == "/BorrowingHistories" || currentPath.StartsWithSegments("/BorrowingHistories/Details")   ? "active" : "")">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                    <a class="nav-link " asp-area="" asp-controller="BorrowingHistories" asp-action="Index">History</a>
                                </li>
                                <li class="nav-item  @(currentPath == "/BorrowingHistories/Create" ? "active" : "")">
                                    <i class="fa-solid fa-cart-plus"></i>
                                    <a class="nav-link " asp-area="" asp-controller="BorrowingHistories" asp-action="Create">Borrow</a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="navbar-header d-flex align-items-center " style="margin-top: 8px;">
                        <partial name="_AdminPartial"/>
                    </div>
                </nav>

            </header>

            <main role="main">
                @RenderBody()
            </main>

        </div>

    }

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
            
      
            $('.pagination-container li').addClass('page-item');
            $('.pagination-container a,.pagination-container span').addClass('page-link');
            $('.pagination-container').addClass("d-flex justify-content-center")      

</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
