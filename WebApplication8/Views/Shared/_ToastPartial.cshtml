@model MessengerViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var name = Model.Status == "true" ? "Success" : "Error";
    var background = Model.Status == "true" ? "#6c6c6c" : "#a10505";

}

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:10">
    <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" style="background:@background; color:whitesmoke; ">
        <div class="toast-header">
            <strong class="me-auto">

                @name

            </strong>
            <small>now</small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @Model.Message
        </div>
    </div>
</div>