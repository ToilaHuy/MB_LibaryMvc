@using X.PagedList
@using X.PagedList.Mvc.Core
@model IEnumerable<WebApplication8.Models.BorrowerVm>
@{
    ViewData["Title"] = "Index";
   
    var showDelete = Url.Action("Delete");
    var showUpdate = Url.Action("Edit");
    var showDetails = Url.Action("Details");


    
}

<div class="d-flex justify-content-between alight-items-center box-search ">
   
    @using (Html.BeginForm("index", "Borrowers", FormMethod.Get, new { @class = "form-class" }))
    {
        <div class="d-flex gap-1 justify-content-between ">
            @Html.TextBox("name" ,"",new
        {
        @style="max-width:72%", @class="form-control rounded-pill border-0 text-white", @placeholder="Search....."

        })
            
            @Html.Hidden("pageSize",ViewBag.onePageOfBorrowers.PageSize,new{})
            <button class="btn rounded-pill btn-secondary " type="submit">Search</button>

        </div>
        
    }
     <div>
        <button class="btn  rounded-pill btn-secondary " id="btnLoadPartialCreateBorrower">Create New</button>
     </div>
</div>

<div class="d-flex justify-content-between align-item-center" style="margin-top: 40px;">
    <h1>Borrower</h1>
</div>
@using (Html.BeginForm("index", "Borrowers", FormMethod.Get, new { @class = "form-class", @id = "pageSizeFormBorrower" }))
{
    @Html.Hidden("name",ViewBag.nameSearch,new{})
    @Html.DropDownList("pageSize", new SelectList(ViewBag.PageSizeOptions, "Value", "Text", ViewBag.onePageOfBorrowers.PageSize.ToString()), new { onchange = "document.getElementById('pageSizeFormBorrower').submit()" ,  @class="form-control rounded-pill border-0  ",@style="max-width:10%; color:#b3b3b3"})
}


@if (TempData["MessageData"] != null)
{
    @(await Html.PartialAsync("_ToastPartial",new MessengerViewModel()
     {
        Message = TempData["MessageData"].ToString(),
        Status = TempData["MessageStatus"].ToString()
     }))
    
    <script>
        $(function() {
            const toastLiveExample = document.getElementById('liveToast')
            const toastBootstrap = bootstrap.Toast.getOrCreateInstance(toastLiveExample)
            toastBootstrap.show()
        });
    </script>
}


<div id="staticBackdropBorrowers" class="modal fade">
</div>
<div class="d-flex mt-2 mb-2  gap-3 align-items-center flex-wrap">
    
 
    @foreach (var borrower in ViewBag.onePageOfBorrowers)
    {

        <div class="card text-black align-self-stretch shadow-sm  bg-body-tertiary rounded " style="width: 15rem; position: relative; background-color:#181818">
           
                <div class="group-svg ">
                    <button type="button" class="btnLoadPartialEditBorrower" data-id="@borrower.BorrowerId">
                        <i class="fa-solid fa-pencil"></i>
                    </button>
                    <button type="button" data-id="@borrower.BorrowerId" class="btnLoadPartialDeleteBorrower">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            <div class="btnLoadPartialDetailBorrower pb-0 p-3" data-id="@borrower.BorrowerId">
                <img src="@borrower.ImageUrl" class="card-img-top" alt="...">
            </div>
            <div class="card-body">
                <h5 class="card-title text-white">@borrower.BorrowerName</h5>
                <p class="card-text">Address: @borrower.Address</p>
            </div>
        </div>
    }
</div>

<div class="d-flex justify-content-between">
    <div>
        Showing @ViewBag.onePageOfBorrowers.FirstItemOnPage to @ViewBag.onePageOfBorrowers.LastItemOnPage of @ViewBag.onePageOfBorrowers.TotalItemCount entries
    </div>
    @if (ViewBag.onePageOfBorrowers.TotalItemCount > ViewBag.onePageOfBorrowers.PageSize)
    {

        @Html.PagedListPager((IPagedList)ViewBag.onePageOfBorrowers, page => Url.Action("Index", new { page,name=ViewBag.nameSearch,pageSize=ViewBag.onePageOfBorrowers.PageSize }) )
    }
</div>



@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            async function getPartialBorrow(url, itemId) {
                var result = await $.ajax({
                    url: url,
                    data: { id: itemId },
                    type: 'GET'
                });
                await $('#staticBackdropBorrowers').html(result);
                await $('#staticBackdropBorrowers').modal('show');
            }

            $(".btnLoadPartialDeleteBorrower").on("click", async function () {
                var itemId = $(this).data("id");
                // Gọi Ajax để lấy nội dung partial view
                await getPartialBorrow('@showDelete',itemId)
            });

            $('#staticBackdropBorrowers').on('hidden.bs.modal', function () {
                $('.modal-dialog').remove();
            });

            $(".btnLoadPartialDetailBorrower").on("click", async function () {
                var itemId = $(this).data("id");
                // Gọi Ajax để lấy nội dung partial view
                await getPartialBorrow('@showDetails', itemId)

            });

            $(".btnLoadPartialEditBorrower").on("click", async function () {
                var itemId = $(this).data("id");
                // Gọi Ajax để lấy nội dung partial view
                await getPartialBorrow('@showUpdate', itemId)
            });

            $("#btnLoadPartialCreateBorrower").on("click", function () {
                $('#staticBackdropBorrowers').load("@Url.Action("Create")", function () {
                    $('#staticBackdropBorrowers').modal('show');
                });

            });

        });
    </script>

}
