@model WebApplication8.Models.BorrowerVm
@using (Html.BeginForm("Edit", "Borrowers", FormMethod.Post, new { enctype = "multipart/form-data", @id = "form-borrower" }))
{
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Create Item</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(model =>model.BorrowerId)
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(model => model.BorrowerName, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.BorrowerName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.BorrowerName, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Address, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                </div>

            </div>
            <div class="modal-footer">
                <div class="form-group  btn-submit">
                    <input type="submit" value="Accept" class="btn btn-primary"/>
                </div>
                <button class="btn btn-primary btn-loading" type="button" disabled>
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    Loading...
                </button>
           
            </div>

        </div>
    </div>
    
}

<script>

    $(document).ready(function () {
        $('.btn-loading').hide();
        $('#form-borrower').submit(function () {

            if ($('#form-borrower').valid()) {

                $('.btn-loading').show();
                $('.btn-submit').hide();

            }

        });
        $('#form-test').validate($.validator.unobtrusive.parse(document));
    })

</script>
