@model WebApplication8.Models.BorrowerVM

@{
    ViewData["Title"] = "Edit";
    
}

<h1>Edit</h1>

<h4>Borrower</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @using (Html.BeginForm("Edit", "Borrowers"))
        {
            @Html.HiddenFor(m => m.BorrowerId)
            <div class="form-group">
                @Html.LabelFor(m => m.BorrowerName, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.BorrowerName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.BorrowerName, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Address, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        }

    </div>
</div>

@Html.ActionLink("Back to List", "Index")
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
