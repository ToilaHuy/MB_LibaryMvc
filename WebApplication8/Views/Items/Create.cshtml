@model WebApplication8.Data.Item

@{
    ViewData["Title"] = "Create";

}

<h1>Create Item</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Category" class="control-label"></label>
                <select id="Category-list" asp-for="Category" class="form-control" asp-items="ViewBag.Category"></select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PublicationDate" class="control-label"></label>
                <input asp-for="PublicationDate" class="form-control" />
                <span asp-validation-for="PublicationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Author" class="control-label"></label>
                <input asp-for="Author" class="form-control" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>
            <div class="form-group" >
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group" id="NumberOfPages">
                <label asp-for="NumberOfPages" class="control-label"></label>
                <input asp-for="NumberOfPages" class="form-control" />
                <span asp-validation-for="NumberOfPages" class="text-danger"></span>
            </div>
            <div class="form-group" id="RunTime">
                <label asp-for="RunTime" class="control-label"></label>
                <input asp-for="RunTime" class="form-control" />
                <span asp-validation-for="RunTime" class="text-danger"></span>
            </div>
    
            <div class="form-group mt-2">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
           
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
  
    <script>
        
        $(document).ready(function () {
            var selectedValue = "Book"
            if (selectedValue === "Book") {
                $('#RunTime').css("display", "none");
                $('#NumberOfPages').css("display", "block");

            }
            $('#Category-list').change(function () {
                 selectedValue = $(this).val();
                if (selectedValue ==="Book"){
                    $('#RunTime').css("display", "none");
                    $('#NumberOfPages').css("display", "block");

                }
                else if (selectedValue === "DVD"){
                    $('#NumberOfPages').css("display", "none");
                    $('#RunTime').css("display", "Block");

                }else 
                {
                    $('#RunTime').css("display", "none");
                    $('#NumberOfPages').css("display", "none");
                }
            });
        })
        
    </script>
}
