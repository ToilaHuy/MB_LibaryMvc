@model WebApplication8.Models.ItemViewModel


<div class="modal-dialog">
    <div class="modal-content ">
        <div class="modal-header">
            <h1 class="modal-title fs-5" id="staticBackdropLabel">Details </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <img src="@Model.ImageUrl" class="card-img-top" alt="...">
            <h5 class="card-title">@Model.Title</h5>
            <p class="card-text">@Html.DisplayNameFor(model => model.Category): @Model.Category</p>
            <p class="card-text">@Html.DisplayNameFor(model => model.Author): @Model.Author</p>
            <p class="card-text">@Html.DisplayNameFor(model => model.PublicationDate): @Model.PublicationDate </p>
            <p class="card-text">Price: @Model.Price.ToString("n0") VNĐ </p>
            @if (Model.Category.ToString() == "Book")
            {
                <p class="card-text">@Html.DisplayNameFor(model => model.NumberOfPages): @Model.NumberOfPages </p>
            }
            @if (Model.Category.ToString() == "DVD")
            {
                <p class="card-text">@Html.DisplayNameFor(model => model.RunTime): @Model.RunTime </p>
            }
            <p class="card-text">@Html.DisplayNameFor(model => model.Quantity): @Model.Quantity </p>
            <p class="card-text">@Html.DisplayNameFor(model => model.AvailableQuantity): @Model.AvailableQuantity </p>
        </div>
        @* <div class="modal-footer"> *@
        @*     <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button> *@
        @* </div> *@
    </div>
</div>