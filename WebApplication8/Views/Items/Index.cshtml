@model IEnumerable<WebApplication8.Models.ItemViewModel>


@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-item-center">
    <h1>List Item</h1>

    <div>
        <button class="btn btn-primary " id="btnLoadPartialCreate">Create New</button>
    </div>
</div>
<input type="text" name="name" placeholder="search" id="searchTerm" />

<add key="ClientValidationEnabled" value="true" />
<add key="UnobtrusiveJavaScriptEnabled" value="true" />



<!-- Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Modal title</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Understood</button>
            </div>
        </div>
    </div>
</div>
<div id="staticBackdropCreate" class="modal fade">
</div>
<div id="staticBackdropRemove" class="modal fade">
</div>
<div class="d-flex mt-2  gap-5 align-items-center flex-wrap">
    
 
    @foreach (var item in Model)
    {
        // var products = item.ItemId;
        // var itemMapper = mapper.Map<ItemViewModel>(item);

        @* @await Html.PartialAsync("_RemoveItemPartial",  item,  new ViewDataDictionary(ViewData) *@
        @*                         { *@
        @*                              { "index", products } *@
        @*                         }) *@
        <div class="card text-black " style="width: 18rem; position: relative">
            <div class="group-svg container-btn-item"  data-id="@item.ItemId" value="@item.ItemId">
                <button type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop" value="@item.ItemId">
                    <i class="fa-solid fa-pencil"></i>
                </button>
                <button type="button" data-id="@item.ItemId" class="btnLoadPartial">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </div>
                <a asp-action="Details" asp-route-id="@item.ItemId">
                    <img src="@item.ImageUrl" class="card-img-top" alt="...">
                </a>
            <div class="card-body">
                <h5 class="card-title">@item.Title</h5>
                <p class="card-text">Category: @item.Category</p>
                <p class="card-text">Author: @item.Author</p>
                <p class="card-text">Price: @item.Price VNĐ</p>
            </div>
        </div>
    }

</div>



<style>
    .group-svg
    {
        position: absolute;
        right:10px ;
        top:10px; 
        display: none;
        cursor:pointer;
    }

        .group-svg > button
        {
            background-color: transparent;
            border:none;
            color: white;
        }
    .card:hover > .group-svg {
        display: block;
    }
    
    .svg 
    {
        width: 20px;
    }

</style>


@*@{
    Html.RenderPartial("_ValidationScriptsPartial");
}*@

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script>
        $(document).ready(function () {
            
            $(".btnLoadPartial").on("click", async function () {
                var itemId = $(this).data("id");       
                // Gọi Ajax để lấy nội dung partial view
                var result = await $.ajax({
                    url: "@Url.Action("Delete")",
                    data: { id: itemId },
                    type: 'GET'
                });
               await $('#staticBackdropRemove').html(result);
                await $('#staticBackdropRemove').modal('show');
    
            });

            $("#btnLoadPartialCreate").on("click", async function () {
             
                // Gọi Ajax để lấy nội dung partial view
            
                $('#staticBackdropCreate').load("@Url.Action("Create")", function(){
                    $('#staticBackdropCreate').modal('show');
                    });
               

            });
            
        });
    </script>
